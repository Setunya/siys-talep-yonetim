# Ortam değişkenleri örneği.
# Bu dosyayı ".env" olarak kopyalayın ve değerleri kendi ortamınıza göre doldurun.
# Gerçek .env dosyası sürüm kontrolüne EKLENMEZ (.gitignore içinde).

# Üretimde mutlaka yeni ve gizli bir anahtar üretin:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=degistirilmeli-uzun-rastgele-bir-anahtar

# Üretimde 0 yapın (hata ayıklama kapalı). Geliştirmede 1.
DJANGO_DEBUG=1
